# qwen-agent / qwen-sweep machine config -- sourced as shell by both.
# install.sh copies this to ~/.config/qwen-agent/config (or $XDG_CONFIG_HOME/...)
# once and never overwrites it. Every value uses ${VAR:-...}, so an environment
# variable or a command-line flag still wins.

# Your model server: anything that serves the Anthropic Messages API at
# /v1/messages and lists its models at /v1/models. No /v1 suffix here.
QWEN_BASE_URL="${QWEN_BASE_URL:-http://127.0.0.1:8000}"

# Leave unset to use the served model when the server serves exactly one.
# QWEN_MODEL="${QWEN_MODEL:-your-served-model-name}"

# Context window. Unset = read max_model_len from /v1/models when reported.
# QWEN_CTX="${QWEN_CTX:-131072}"

# Passed to claude --effort (default medium). If your model's chat template only
# accepts some levels, list them so a bad level fails fast instead of as a 400:
# QWEN_EFFORT="${QWEN_EFFORT:-medium}"
# QWEN_EFFORT_ALLOWED="${QWEN_EFFORT_ALLOWED:-low medium high}"

# If the server requires a key (sent as the Anthropic auth token):
# QWEN_API_KEY="${QWEN_API_KEY:-}"

# Where the claude executable is when it is not on PATH (install.sh's rc=8 names this).
# QWEN_CLAUDE_BIN="${QWEN_CLAUDE_BIN:-claude}"

# Claude calls (off unless you set them). Only THIS file turns one on: an exported
# QWEN_PLAN / QWEN_ADVISOR / QWEN_RESCUE / QWEN_CONFIRM is ignored. Each value is a model
# name (opus, sonnet, an id) or off. A typed --plan / --advisor / --rescue overrides it for
# one run. What leaves the machine: SECURITY.md. `qwen-agent --show-claude` prints the result.
# Measured (reference/benchmark.md): plan + advisor is the pair worth turning on; rescue
# added nothing on top of them and cost the most.
# QWEN_PLAN="${QWEN_PLAN:-opus}"        # review the plan before the first file edit
# QWEN_ADVISOR="${QWEN_ADVISOR:-opus}"  # the agent's ask tool (QWEN_ADVISOR_MAX_CALLS, default 4)
# QWEN_RESCUE="${QWEN_RESCUE:-opus}"    # after a failing --until-done round (mixed results)
# QWEN_CONFIRM="${QWEN_CONFIRM:-opus}"  # ui-test double-check: a model, local (default) or none
# Plan, advisor and rescue calls may read files in your repository (Read, Grep, Glob);
# 0 turns that off. Per-call timeout (seconds) and the claude binary they run:
# QWEN_CLAUDE_TOOLS="${QWEN_CLAUDE_TOOLS:-1}"
# QWEN_ADVISOR_TIMEOUT="${QWEN_ADVISOR_TIMEOUT:-600}"
# QWEN_ADVISOR_CLAUDE="${QWEN_ADVISOR_CLAUDE:-claude}"

# Pin the interpreter used to parse results. Probed by RUNNING it: on Windows a
# bare `python3` is often a Microsoft Store stub that cannot execute anything.
# QWEN_PYTHON="${QWEN_PYTHON:-python}"

# The project test command qwen-test runs (the model only picks WHICH tests).
# Set per machine; a repo-specific value can be exported before calling qwen-agent.
# Windows: use forward slashes in paths (C:/Python312/python.exe): the value is
# split like a POSIX shell line, which drops backslashes.
# QWEN_TEST_CMD="${QWEN_TEST_CMD:-python -m pytest -q}"
# QWEN_TEST_TIMEOUT="${QWEN_TEST_TIMEOUT:-600}"
